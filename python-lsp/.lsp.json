{
  "python": {
    "command": "uv",
    "args": [
      "run",
      "--script",
      "${CLAUDE_PLUGIN_ROOT}/scripts/lsp_mux.py",
      "${CLAUDE_PLUGIN_ROOT}/servers.json"
    ],
    "extensionToLanguage": {
      ".py": "python",
      ".pyi": "python"
    },
    "startupTimeout": 60000,
    "settings": {
      "basedpyright": {
        "analysis": {
          "diagnosticSeverityOverrides": {
            "reportAny": "none"
          }
        }
      }
    }
  }
}
