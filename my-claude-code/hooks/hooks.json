{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--script",
              "${CLAUDE_PLUGIN_ROOT}/scripts/remind_to_locate.py"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(grep *)",
            "command": "uv",
            "args": [
              "run",
              "--script",
              "${CLAUDE_PLUGIN_ROOT}/scripts/remind_to_locate.py"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--script",
              "${CLAUDE_PLUGIN_ROOT}/scripts/report_locate_savings.py"
            ]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(~/.claude/plugins/data/*/handoffs/**)",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "if": "Read(~/.claude/plugins/data/*/handoffs/**)",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'"
          },
          {
            "type": "command",
            "if": "Read(~/.claude/plugins/cache/*/my-claude-code/*/skills/claude-code-mastery/references/**)",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(grep * */.claude/plugins/cache/*/my-claude-code/*/skills/claude-code-mastery/references/*)",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'"
          }
        ]
      }
    ]
  }
}
