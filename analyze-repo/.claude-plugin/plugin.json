{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "analyze-repo",
  "version": "0.1.0",
  "description": "Repository code intelligence: symbols and references from basedpyright, syntactic roles from tree-sitter, call edges and model-written summaries in sqlite, served over MCP.",
  "author": {
    "name": "estasney",
    "email": "estasney@users.noreply.github.com"
  },
  "mcpServers": {
    "analyze-repo": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "--frozen",
        "--no-dev",
        "--no-python-downloads",
        "analyze-repo"
      ],
      "env": {
        "ANALYZE_REPO_DATA_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
