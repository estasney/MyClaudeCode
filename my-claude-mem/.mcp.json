{
  "mcpServers": {
    "memory": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "--frozen",
        "--no-dev",
        "--no-python-downloads",
        "vexicon"
      ],
      "env": {
        "ORT_DISABLE_TELEMETRY": "1",
        "VEXICON_PERSISTENT_PATH": "${CLAUDE_PLUGIN_DATA}/chroma",
        "VEXICON_INDEX_DB_PATH": "${CLAUDE_PLUGIN_DATA}/hybrid.db"
      }
    }
  }
}
