{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "sync",
              "--project",
              "${CLAUDE_PLUGIN_ROOT}",
              "--frozen",
              "--no-dev",
              "--no-python-downloads"
            ],
            "timeout": 600,
            "statusMessage": "Syncing claude-memory environment"
          }
        ]
      }
    ]
  }
}
